# Copy to .env for local dev (.env is gitignored). In dev/staging/prod on ECS these same
# variables are injected from AWS Secrets Manager via the task definition — see
# docs/architecture/config-and-secrets.md. The app only ever reads them from the environment.

NODE_ENV=development
PORT=3000

# Database components. The app assembles the connection string from these (buildDatabaseUrl).
# On ECS these are injected straight from the RDS-managed secret — nothing to hand-populate.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=hms
DATABASE_PASSWORD=hms
DATABASE_NAME=hms
# TLS mode for the Postgres connection. Defaults to `require` (RDS enforces TLS). Set to
# `disable` for a local Postgres that has no SSL configured.
DATABASE_SSLMODE=disable

# Cognito — single shared user pool (ap-south-2 = Hyderabad, for India data residency).
# Local dev placeholders are fine until a real pool exists; token verification will 401.
AWS_REGION=ap-south-2
COGNITO_USER_POOL_ID=ap-south-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Patient notifications. Leave disabled locally (uses logging stubs — never sends). Set to true
# in deployed envs with a verified SES sender + India DLT for SMS.
NOTIFICATIONS_ENABLED=false
# NOTIFICATIONS_EMAIL_FROM=no-reply@yourdomain.in   # verified SES identity
# SMS_SENDER_ID=POLARS                              # DLT-registered sender ID
# SMS_DLT_ENTITY_ID=xxxxxxxxxxxxxxxxxxx             # DLT principal-entity ID

# AI assist (docs/architecture/ai-features.md). Leave disabled locally — a deterministic stub
# provider runs instead, so nothing calls Bedrock or costs money. When enabling, resolve the real
# model id first: `aws bedrock list-inference-profiles --region <region>`.
AI_ENABLED=false
# AI_SUMMARY_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0   # REQUIRED when AI_ENABLED=true
# AI_CHART_MODEL_ID=...            # optional; ask-this-chart model. Falls back to AI_SUMMARY_MODEL_ID
# BEDROCK_REGION=ap-south-1        # only for the in-India older-model option; current models work from ap-south-2
# NOTE: current Claude in the India regions is `global.`-profile only → inference routes worldwide.
# That is a DPDP data-residency decision — see docs/architecture/ai-features.md before enabling in prod.
