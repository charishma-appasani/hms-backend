// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Models translated from docs/architecture/data-model.md (the source of truth).
// Conventions:
//  - org_id and domain FKs are modelled as relations (Prisma manages the FKs).
//  - Audit attribution (created_by / updated_by / deleted_by, updated_by_org/_user) are plain
//    uuid columns, NOT relations — they're metadata, set by the app from the request user.
//  - Tenant scoping (filter by org_id) and soft-delete filtering (deleted_at IS NULL) are
//    enforced in app code (a base service / Prisma $extends), not RLS.

// ───────────────────────── enums ─────────────────────────
enum Gender {
  male
  female
  other
}

// Unified record on/off status. A record is `active` from creation until an authorized person
// turns it off (`disabled`, incl. suspended) — there is no pending/onboarding state. Workflow
// lifecycle enums (slot / appointment / visit / schedule_exception) are separate.
enum Status {
  active
  disabled
}

enum UserRole {
  admin
  doctor
  doctor_assistant // records the clinical note on a doctor's behalf (doctor-scoping still deferred)
  front_desk
  nurse
}

// Platform operators (our own company) — null for all customers/patients. Org roles answer
// "what can you do at this org"; platform roles answer "what can you do to the platform".
enum PlatformRole {
  super_admin // onboard/manage orgs, bootstrap org admins, full platform control
  support // read/assist; no destructive ops
  data_entry // master-data curator: the medicine catalog only, nothing tenant-facing
}

enum AvailabilityMode {
  slot
  token
}

enum ExceptionType {
  time_off
  holiday
  surgery
  busy
  extra_session
}

enum SlotStatus {
  open
  blocked
}

enum AppointmentType {
  new
  follow_up
}

enum AppointmentChannel {
  walk_in
  phone
  online
  patient_app
}

enum AppointmentStatus {
  requested
  confirmed
  checked_in
  fulfilled
  cancelled
  no_show
  rescheduled
}

enum VisitStatus {
  checked_in
  in_consultation
  completed
  cancelled
}

enum TestOrderStatus {
  ordered
  collected
  resulted
  cancelled
}

enum ConsentType {
  org_link
}

enum ConsentMethod {
  otp
}

enum SequenceScope {
  org
  practice
}

enum SequenceName {
  uhid
  visit
}

enum AiGenerationKind {
  visit_summary // the doctor-facing patient orientation shown when a visit starts
  patient_summary // the plain-language after-visit summary shown to the patient in the portal
}

enum AiGenerationStatus {
  pending // row claimed, inference in flight
  ready // output present and parsed
  failed // inference or parsing failed; `error` explains. Never blocks the clinical flow
}

// ──────────────── platform layer (global, no org_id) ────────────────
model AppUser {
  id            String        @id @default(uuid(7)) @db.Uuid
  cognitoSub    String        @unique @map("cognito_sub") @db.VarChar(64)
  firstName     String        @map("first_name") @db.VarChar(80)
  lastName      String?       @map("last_name") @db.VarChar(80)
  phone         String?       @unique @db.VarChar(20) // unique per person (no shared phones)
  email         String?       @unique @db.VarChar(160) // unique per person
  dateOfBirth   DateTime?     @map("date_of_birth") @db.Date
  gender        Gender?
  status        Status        @default(active)
  platformRole  PlatformRole? @map("platform_role") // set only for our own operators
  // Profile photo marker: non-null ⇒ an object exists at `user/<id>/avatar` in the PRIVATE image
  // bucket, and its value is the cache-busting version. One object per person, overwritten in
  // place. See docs/architecture/asset-storage.md.
  imageUpdatedAt DateTime?    @map("image_updated_at") @db.Timestamptz
  updatedByOrg  String?       @map("updated_by_org") @db.Uuid // cross-org demographic attribution
  updatedByUser String?       @map("updated_by_user") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  patient Patient?
  staff   Staff[]

  @@map("app_user")
}

model Patient {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid // 1:1 with app_user
  abhaNumber  String?  @unique @map("abha_number") @db.VarChar(17)
  abhaAddress String?  @unique @map("abha_address") @db.VarChar(64)
  isVerified  Boolean  @default(false) @map("is_verified")
  // ID / insurance-card scan marker (PRIVATE bucket, `patient/<id>/id-card`). Separate from the
  // avatar on app_user: different purpose, different sensitivity, its own delete.
  idCardUpdatedAt DateTime? @map("id_card_updated_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user          AppUser               @relation(fields: [userId], references: [id])
  registrations PatientRegistration[]
  consents      Consent[]
  appointments  Appointment[]
  visits        Visit[]
  conditions    PatientCondition[]
  aiGenerations AiGeneration[]
  aiChartQueries AiChartQuery[]

  @@index([abhaNumber])
  @@map("patient")
}

enum ConditionType {
  condition // chronic/ongoing illness (diabetes, hypertension, asthma, …)
  allergy // drug/food/other allergy — surfaced prominently in the consultation banner
}

enum ConditionStatus {
  active
  resolved
}

// Patient-level clinical facts (existing conditions + allergies). GLOBAL like the patient (no
// org_id): allergies and chronic illnesses are safety-critical and must follow the patient to
// every org they're registered at. Staff access requires an ACTIVE registration at the acting
// org (enforced in PatientsService); attribution records which org/user noted it. Soft delete.
model PatientCondition {
  id             String          @id @default(uuid(7)) @db.Uuid
  patientId      String          @map("patient_id") @db.Uuid
  type           ConditionType   @default(condition)
  name           String          @db.VarChar(200)
  status         ConditionStatus @default(active)
  notes          String?
  recordedByOrg  String?         @map("recorded_by_org") @db.Uuid
  recordedByUser String?         @map("recorded_by_user") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?       @map("deleted_at") @db.Timestamptz
  deletedBy      String?         @map("deleted_by") @db.Uuid

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@map("patient_condition")
}

// Master medicine catalog (GLOBAL, platform-curated — no org): feeds the prescription
// autocomplete on the consultation page. Maintained by platform operators on the console's
// Medicines page (/platform/medicines: search, CRUD, CSV import; super_admin + data_entry).
// Prescriptions stay free text — picking a suggestion just fills the fields.
model Medicine {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String    @db.VarChar(200) // brand/trade name (what doctors type)
  genericName  String?   @map("generic_name") @db.VarChar(200)
  manufacturer String?   @db.VarChar(200)
  ingredients  String? // composition, free text
  form         String?   @db.VarChar(60) // tablet / syrup / injection / cream …
  strength     String?   @db.VarChar(60) // 500 mg, 5 mg/5 ml …
  // Pharmacological class for the deterministic allergy check (tier 2 — see ai-features.md).
  // Free text normalized in code against DRUG_CLASSES (e.g. 'penicillins', 'sulfonamides',
  // 'nsaids'). Nullable: rows without a class still get tier-1 token matching.
  drugClass    String?   @map("drug_class") @db.VarChar(80)
  // Pack/strip photo marker (CDN bucket, `medicine/<id>/photo`) — helps staff confirm the right
  // brand at dispensing time.
  imageUpdatedAt DateTime? @map("image_updated_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  @@index([name])
  @@map("medicine")
}

// Short-lived OTP challenge (global; no org) — patient self-signup, cross-org link consent,
// org self-signup. `identifier` is the contact being verified (a phone OR an email; it keys the
// rate limits + verification). Code is stored hashed; verified against expiry + an attempt cap.
// Pruned after use/expiry.
model OtpChallenge {
  id         String    @id @default(uuid(7)) @db.Uuid
  identifier String    @db.VarChar(320)
  codeHash   String    @map("code_hash") @db.VarChar(128)
  purpose    String    @db.VarChar(40) // e.g. 'patient_signup'
  attempts   Int       @default(0)
  ip         String?   @db.VarChar(45) // request IP (for per-IP rate limiting; IPv6-sized)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, purpose])
  @@index([ip, createdAt])
  @@map("otp_challenge")
}

// ──────────────── tenant layer (org-scoped) ────────────────
model Organization {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @db.VarChar(160)
  legalName  String?   @map("legal_name") @db.VarChar(200)
  status     Status    @default(active)
  uhidFormat String    @default("UH{seq:08}") @map("uhid_format") @db.VarChar(64)
  settings   Json      @default("{}")
  approvedAt DateTime? @map("approved_at") @db.Timestamptz // null = awaiting platform approval; gates public directory visibility + patient self-booking
  // Logo marker (CDN bucket, `org/<id>/logo`): non-null ⇒ an object exists, value = cache version.
  imageUpdatedAt DateTime? @map("image_updated_at") @db.Timestamptz
  approvedBy String?   @map("approved_by") @db.Uuid // platform operator who approved (operator-created orgs are approved at creation)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid // platform operator who onboarded the org, or the self-signup founding admin
  updatedBy  String?   @map("updated_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy  String?   @map("deleted_by") @db.Uuid

  practices             Practice[]
  staff                 Staff[]
  staffPractices        StaffPractice[]
  registrations         PatientRegistration[]
  consents              Consent[]
  availabilityTemplates AvailabilityTemplate[]
  scheduleExceptions    ScheduleException[]
  slots                 Slot[]
  appointments          Appointment[]
  visits                Visit[]
  numberSequences       NumberSequence[]
  auditLogs             AuditLog[]
  prescriptions         Prescription[]
  testOrders            TestOrder[]
  aiGenerations         AiGeneration[]
  aiChartQueries        AiChartQuery[]

  @@map("organization")
}

model Practice {
  id        String    @id @default(uuid(7)) @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  name      String    @db.VarChar(160)
  code      String    @db.VarChar(32)
  addressId String?   @unique @map("address_id") @db.Uuid // → address (1:1; nested-managed)
  timezone  String    @default("Asia/Kolkata") @db.VarChar(40)
  status    Status    @default(active)
  // Branch photo marker (CDN bucket, `practice/<id>/photo`).
  imageUpdatedAt DateTime? @map("image_updated_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy String?   @map("deleted_by") @db.Uuid

  org                   Organization           @relation(fields: [orgId], references: [id])
  address               Address?               @relation(fields: [addressId], references: [id])
  staffPractices        StaffPractice[]
  availabilityTemplates AvailabilityTemplate[]
  scheduleExceptions    ScheduleException[]
  slots                 Slot[]
  appointments          Appointment[]
  visits                Visit[]

  @@unique([orgId, code])
  @@map("practice")
}

// Entity-agnostic postal address (India). A LEAN value table — no org_id, no audit/soft-delete,
// not tenant-scoped. Owners (practice today; organization/patient later) hold `address_id` and
// reach it via their own 1:1 relation; scope comes from the owner (a patient's address is global,
// a practice's is reached via the scoped practice). Managed nested within its owner, not via its
// own endpoint. Back-refs are added here per owner type as they gain addresses.
model Address {
  id         String   @id @default(uuid(7)) @db.Uuid
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  landmark   String?  @db.VarChar(120)
  city       String   @db.VarChar(120)
  state      String   @db.VarChar(120)
  postalCode String   @map("postal_code") @db.VarChar(12) // PIN code (6 digits in India)
  country    String   @default("IN") @db.VarChar(2) // ISO 3166-1 alpha-2
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  practice Practice? // 1:1 back-ref; add patient/organization as they gain addresses

  @@map("address")
}

// A user's membership at an org. roles[] drive authz. Clinician fields (specialty/reg_no/fee)
// are set only when roles include 'doctor' — a "provider" is just a staff row with a clinical role.
model Staff {
  id                 String     @id @default(uuid(7)) @db.Uuid
  orgId              String     @map("org_id") @db.Uuid
  userId             String     @map("user_id") @db.Uuid
  roles              UserRole[] @default([])
  status             Status     @default(active)
  specialty          String?    @db.VarChar(120)
  registrationNumber String?    @map("registration_number") @db.VarChar(64)
  consultationFee    Decimal?   @map("consultation_fee") @db.Decimal(10, 2)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  createdBy          String?    @map("created_by") @db.Uuid
  updatedBy          String?    @map("updated_by") @db.Uuid
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz
  deletedBy          String?    @map("deleted_by") @db.Uuid

  org                   Organization           @relation(fields: [orgId], references: [id])
  user                  AppUser                @relation(fields: [userId], references: [id])
  practices             StaffPractice[]
  availabilityTemplates AvailabilityTemplate[]
  scheduleExceptions    ScheduleException[]
  slots                 Slot[]
  appointments          Appointment[]
  visits                Visit[]

  @@unique([orgId, userId])
  @@map("staff")
}

model StaffPractice {
  orgId      String @map("org_id") @db.Uuid
  staffId    String @map("staff_id") @db.Uuid
  practiceId String @map("practice_id") @db.Uuid

  org      Organization @relation(fields: [orgId], references: [id])
  staff    Staff        @relation(fields: [staffId], references: [id])
  practice Practice     @relation(fields: [practiceId], references: [id])

  @@id([staffId, practiceId])
  @@map("staff_practice")
}

// OTP/consent captured when a NEW org links to a (possibly pre-existing) patient.
model Consent {
  id         String        @id @default(uuid(7)) @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  patientId  String        @map("patient_id") @db.Uuid
  type       ConsentType   @default(org_link)
  method     ConsentMethod @default(otp)
  reference  String?       @db.VarChar(80)
  verifiedAt DateTime      @map("verified_at") @db.Timestamptz
  expiresAt  DateTime?     @map("expires_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?       @map("created_by") @db.Uuid

  org           Organization          @relation(fields: [orgId], references: [id])
  patient       Patient               @relation(fields: [patientId], references: [id])
  registrations PatientRegistration[]

  @@map("consent")
}

// THE GATE: org ↔ global patient. Existence = visibility. Created lazily on first booking.
model PatientRegistration {
  id          String    @id @default(uuid(7)) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  uhid        String    @db.VarChar(40)
  status      Status    @default(active)
  consentId   String?   @map("consent_id") @db.Uuid
  firstSeenAt DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  deletedBy   String?   @map("deleted_by") @db.Uuid

  org     Organization @relation(fields: [orgId], references: [id])
  patient Patient      @relation(fields: [patientId], references: [id])
  consent Consent?     @relation(fields: [consentId], references: [id])

  @@unique([orgId, patientId])
  @@unique([orgId, uhid])
  @@map("patient_registration")
}

model AvailabilityTemplate {
  id               String           @id @default(uuid(7)) @db.Uuid
  orgId            String           @map("org_id") @db.Uuid
  practiceId       String           @map("practice_id") @db.Uuid
  providerId       String           @map("provider_id") @db.Uuid // → staff (the clinician)
  weekday          Int              @db.SmallInt // 0=Sun .. 6=Sat
  startTime        DateTime         @map("start_time") @db.Time
  endTime          DateTime         @map("end_time") @db.Time
  mode             AvailabilityMode
  slotDurationMins Int?             @map("slot_duration_mins")
  apptCapacity     Int              @default(1) @map("appt_capacity")
  walkinCapacity   Int              @default(0) @map("walkin_capacity")
  validFrom        DateTime         @map("valid_from") @db.Date
  validTo          DateTime?        @map("valid_to") @db.Date
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  createdBy        String?          @map("created_by") @db.Uuid
  updatedBy        String?          @map("updated_by") @db.Uuid
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz
  deletedBy        String?          @map("deleted_by") @db.Uuid

  org      Organization @relation(fields: [orgId], references: [id])
  practice Practice     @relation(fields: [practiceId], references: [id])
  provider Staff        @relation(fields: [providerId], references: [id])
  slots    Slot[]

  @@index([orgId, practiceId, providerId, weekday])
  @@map("availability_template")
}

// Doctor blocks (time off / surgery / busy / holiday) and ad-hoc extra sessions.
model ScheduleException {
  id         String        @id @default(uuid(7)) @db.Uuid
  orgId      String        @map("org_id") @db.Uuid
  providerId String        @map("provider_id") @db.Uuid // → staff
  practiceId String?       @map("practice_id") @db.Uuid // null = all practices
  type       ExceptionType
  startAt    DateTime      @map("start_at") @db.Timestamptz
  endAt      DateTime      @map("end_at") @db.Timestamptz
  allDay     Boolean       @default(false) @map("all_day")
  reason     String?       @db.VarChar(200)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?       @map("created_by") @db.Uuid
  updatedBy  String?       @map("updated_by") @db.Uuid
  deletedAt  DateTime?     @map("deleted_at") @db.Timestamptz
  deletedBy  String?       @map("deleted_by") @db.Uuid

  org      Organization @relation(fields: [orgId], references: [id])
  provider Staff        @relation(fields: [providerId], references: [id])
  practice Practice?    @relation(fields: [practiceId], references: [id])

  @@index([orgId, providerId, startAt])
  @@map("schedule_exception")
}

// Materialized bookable slots. Two capacity buckets (appt / walk-in); available = capacity -
// booked is computed in app. Booking = atomic conditional UPDATE on the relevant bucket.
model Slot {
  id             String           @id @default(uuid(7)) @db.Uuid
  orgId          String           @map("org_id") @db.Uuid
  practiceId     String           @map("practice_id") @db.Uuid
  providerId     String           @map("provider_id") @db.Uuid // → staff
  templateId     String?          @map("template_id") @db.Uuid
  mode           AvailabilityMode
  startAt        DateTime         @map("start_at") @db.Timestamptz
  endAt          DateTime         @map("end_at") @db.Timestamptz
  apptCapacity   Int              @map("appt_capacity")
  apptBooked     Int              @default(0) @map("appt_booked")
  walkinCapacity Int              @default(0) @map("walkin_capacity")
  walkinBooked   Int              @default(0) @map("walkin_booked")
  status         SlotStatus       @default(open)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  org          Organization          @relation(fields: [orgId], references: [id])
  practice     Practice              @relation(fields: [practiceId], references: [id])
  provider     Staff                 @relation(fields: [providerId], references: [id])
  template     AvailabilityTemplate? @relation(fields: [templateId], references: [id])
  appointments Appointment[]

  @@unique([providerId, startAt])
  @@index([orgId, practiceId, providerId, startAt])
  @@map("slot")
}

// Unified booking table: scheduled appointments AND walk-ins.
model Appointment {
  id          String             @id @default(uuid(7)) @db.Uuid
  orgId       String             @map("org_id") @db.Uuid
  practiceId  String             @map("practice_id") @db.Uuid
  patientId   String             @map("patient_id") @db.Uuid
  providerId  String             @map("provider_id") @db.Uuid // → staff (the clinician)
  slotId      String             @map("slot_id") @db.Uuid
  mode        AvailabilityMode
  sessionDate DateTime           @map("session_date") @db.Date
  tokenNumber Int?               @map("token_number")
  apptType    AppointmentType    @default(new) @map("appt_type")
  channel     AppointmentChannel // walk_in collapses booking + check-in
  status      AppointmentStatus  @default(requested)
  reason      String?
  // When this appointment was created by rescheduling another, points back to the original
  // (which is left in status 'rescheduled') — so the UI can show both old and new details.
  rescheduledFromId String?      @map("rescheduled_from_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  createdBy   String?            @map("created_by") @db.Uuid
  updatedBy   String?            @map("updated_by") @db.Uuid
  deletedAt   DateTime?          @map("deleted_at") @db.Timestamptz
  deletedBy   String?            @map("deleted_by") @db.Uuid

  org             Organization  @relation(fields: [orgId], references: [id])
  practice        Practice      @relation(fields: [practiceId], references: [id])
  patient         Patient       @relation(fields: [patientId], references: [id])
  provider        Staff         @relation(fields: [providerId], references: [id])
  slot            Slot          @relation(fields: [slotId], references: [id])
  rescheduledFrom Appointment?  @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment[] @relation("AppointmentReschedule")
  visits          Visit[]

  @@index([orgId, practiceId, providerId, sessionDate])
  @@index([orgId, patientId])
  @@map("appointment")
}

model Visit {
  id            String      @id @default(uuid(7)) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  practiceId    String      @map("practice_id") @db.Uuid
  patientId     String      @map("patient_id") @db.Uuid
  providerId    String      @map("provider_id") @db.Uuid // → staff (the clinician)
  appointmentId String?     @map("appointment_id") @db.Uuid // normally set (walk-ins too)
  visitNumber   String      @map("visit_number") @db.VarChar(40)
  tokenNumber   Int         @map("token_number")
  status        VisitStatus @default(checked_in)
  checkInAt     DateTime    @default(now()) @map("check_in_at") @db.Timestamptz
  startedAt     DateTime?   @map("started_at") @db.Timestamptz
  completedAt   DateTime?   @map("completed_at") @db.Timestamptz
  vitals        Json?
  symptoms      String?     @db.Text // presenting complaints (free text)
  diagnosis     String?     @db.Text // clinical impression / diagnosis (free text)
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String?     @map("created_by") @db.Uuid
  updatedBy     String?     @map("updated_by") @db.Uuid
  deletedAt     DateTime?   @map("deleted_at") @db.Timestamptz
  deletedBy     String?     @map("deleted_by") @db.Uuid

  org         Organization @relation(fields: [orgId], references: [id])
  practice    Practice     @relation(fields: [practiceId], references: [id])
  patient     Patient      @relation(fields: [patientId], references: [id])
  provider    Staff        @relation(fields: [providerId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
  testOrders    TestOrder[]
  aiGenerations AiGeneration[]
  aiChartQueries AiChartQuery[]

  @@unique([practiceId, visitNumber])
  @@index([orgId, practiceId, providerId, status, checkInAt])
  @@map("visit")
}

// A prescribed medication line on a visit (doctor-entered). Deletable before the visit completes.
model Prescription {
  id           String   @id @default(uuid(7)) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  visitId      String   @map("visit_id") @db.Uuid
  drug         String   @db.VarChar(200)
  dosage       String?  @db.VarChar(120) // e.g. "500 mg"
  frequency    String?  @db.VarChar(120) // e.g. "twice daily"
  duration     String?  @db.VarChar(120) // e.g. "5 days"
  instructions String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid

  org   Organization @relation(fields: [orgId], references: [id])
  visit Visit        @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("prescription")
}

// A test/investigation ordered on a visit; carries a lifecycle + result filled in later.
model TestOrder {
  id           String          @id @default(uuid(7)) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  visitId      String          @map("visit_id") @db.Uuid
  name         String          @db.VarChar(200)
  instructions String?         @db.Text
  status       TestOrderStatus @default(ordered)
  result       String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?         @map("created_by") @db.Uuid
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy    String?         @map("updated_by") @db.Uuid

  org   Organization @relation(fields: [orgId], references: [id])
  visit Visit        @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@map("test_order")
}

// Atomic per-tenant counters (UHID, visit#). Token# comes from slot.*_booked, not here.
model NumberSequence {
  id           String        @id @default(uuid(7)) @db.Uuid
  orgId        String        @map("org_id") @db.Uuid
  scope        SequenceScope
  scopeId      String        @map("scope_id") @db.Uuid
  name         SequenceName
  currentValue BigInt        @default(0) @map("current_value")

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, scope, scopeId, name])
  @@map("number_sequence")
}

// Append-only PHI/consent trail (full field-level history).
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  orgId       String?  @map("org_id") @db.Uuid // null for platform-level ops
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String?  @map("entity_id") @db.Uuid
  patientId   String?  @map("patient_id") @db.Uuid
  metadata    Json     @default("{}")
  ip          String?  @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization? @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([patientId])
  @@map("audit_log")
}

// One cached AI generation (see docs/architecture/ai-features.md). Holds the exact input the
// model saw plus its output, so a generation is reproducible after the fact (medico-legal),
// cacheable (`input_hash` = sha256 of the canonical dossier), and evaluable (`feedback`).
// AI output is ADVISORY — it is never part of the clinical record, which is why this table is
// separate from `visit` and carries no soft delete.
model AiGeneration {
  id        String             @id @default(uuid(7)) @db.Uuid
  orgId     String             @map("org_id") @db.Uuid
  kind      AiGenerationKind
  visitId   String?            @map("visit_id") @db.Uuid // null for future patient-level kinds
  patientId String             @map("patient_id") @db.Uuid
  status    AiGenerationStatus @default(pending)
  // sha256 of the canonical dossier JSON — a mismatch means the record changed → regenerate.
  inputHash String             @map("input_hash") @db.VarChar(64)
  // Exactly what the model was given. PHI, same as its source rows; kept for reproducibility.
  inputSnapshot Json?    @map("input_snapshot")
  output        Json? // the parsed, schema-validated result
  modelId       String?  @map("model_id") @db.VarChar(160) // resolved inference profile / model id
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  error         String? // failure reason when status = failed
  // Doctor feedback: -1 / +1. Drives the evaluation set; nullable = not rated.
  feedback   Int?
  feedbackBy String?   @map("feedback_by") @db.Uuid
  feedbackAt DateTime? @map("feedback_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid

  org     Organization @relation(fields: [orgId], references: [id])
  visit   Visit?       @relation(fields: [visitId], references: [id])
  patient Patient      @relation(fields: [patientId], references: [id])

  // One current generation per visit per kind — regeneration overwrites in place (the audit_log
  // records each regeneration). Switch to append-only if summaries ever become quotable.
  @@unique([visitId, kind])
  @@index([orgId, patientId, kind])
  @@map("ai_generation")
}

// Ask-this-chart: one natural-language question a clinician asked about a patient, and the
// model's grounded answer (see docs/architecture/ai-features.md). APPEND-ONLY — many rows per
// patient, each a distinct question — which is why it is its OWN table, not `ai_generation`
// (that one is a single cached artifact per visit, overwritten in place). No caching (every
// question differs) and no status lifecycle (the request is synchronous — the clinician waits).
// Stores `input_hash` (which record state answered it) but NOT the full dossier snapshot: one
// snapshot per question is heavy, and the audit need here is "who asked what, answered how".
model AiChartQuery {
  id            String   @id @default(uuid(7)) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  visitId       String?  @map("visit_id") @db.Uuid // the visit it was asked from (context only)
  patientId     String   @map("patient_id") @db.Uuid
  question      String   @db.Text
  answer        String   @db.Text
  foundInRecord Boolean  @map("found_in_record") // false = the record didn't contain the answer
  citations     Json     @default("[]") // dossier cite ids the answer drew on (string[])
  inputHash     String   @map("input_hash") @db.VarChar(64) // sha256 of the dossier that answered it
  modelId       String?  @map("model_id") @db.VarChar(160)
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  feedback      Int? // -1 / +1, the evaluation signal
  feedbackBy    String?  @map("feedback_by") @db.Uuid
  feedbackAt    DateTime? @map("feedback_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid

  org     Organization @relation(fields: [orgId], references: [id])
  visit   Visit?       @relation(fields: [visitId], references: [id])
  patient Patient      @relation(fields: [patientId], references: [id])

  @@index([orgId, patientId, createdAt])
  @@map("ai_chart_query")
}
